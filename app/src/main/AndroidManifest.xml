<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <activity android:name=".ui.LoginActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.HomeActivity" android:exported="false" />
        <activity android:name=".ui.RecordListActivity" android:exported="false" />
        <activity android:name=".ui.RecordDetailActivity" android:exported="false" />
        <activity android:name=".ui.RecordFormActivity" android:exported="false" />
        <activity android:name=".ui.StockTransferActivity" android:exported="false" />
    </application>
</manifest>
